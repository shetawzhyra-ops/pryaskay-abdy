# Pryaskay Abdy — Environment Configuration Example
# Copy this file to .env and fill in real values before production deployment.

# Server Port
PORT=3000

# Set to 'production' on live servers (enforces strong JWT_SECRET & stricter CORS)
NODE_ENV=development

# REQUIRED in production: generate a 64-byte random hex key using:
#   npm run generate-secret
JWT_SECRET=replace_this_with_a_long_random_64_char_secret_key

# Comma-separated allowed origins in production (e.g. https://pryaska.com,https://www.pryaska.com)
# Leave empty in local development to allow localhost origins.
ALLOWED_ORIGINS=

# Optional: Offsite Database Backup (Telegram Bot or Webhook)
TELEGRAM_BACKUP_BOT_TOKEN=
TELEGRAM_BACKUP_CHAT_ID=
BACKUP_WEBHOOK_URL=
